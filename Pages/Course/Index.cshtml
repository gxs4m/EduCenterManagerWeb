@page
@model EduCenterManagerWeb.Pages.Course.IndexModel
@{
    ViewData["Title"] = "Index de Cursos";
}
<h1>Lista de Cursos</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Courses[0].NombreCurso)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Courses[0].Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Courses[0].Teachers)
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Courses)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.NombreCurso)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Descripcion)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Teachers)
                </td>
                <td></td>
                <td></td>
            </tr>
        }
    </tbody>
</table>