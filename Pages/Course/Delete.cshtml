@page
@model EduCenterManagerWeb.Pages.Course.DeleteModel
@{
    ViewData["Title"] = "Eliminar Courso";
}
<h1>Eliminar Curso</h1>
<h3>¿Estas seguro de que deseas eliminar este curso?</h3>
<div>
    <h4>Curso</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Courses.NombreCurso)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Courses.NombreCurso)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Courses.Descripcion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Courses.Descripcion)
        </dd>
        <dt class="col-sm-2">
@Html.DisplayNameFor(model => model.Courses.Teachers)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Courses.Teachers)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Courses.Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> &nbsp;
        <a asp-page="./Index" class="btn btn-primary">Volver a la lista</a>
    </form>
</div>
